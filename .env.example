SECRET_KEY=change_me
ENV=production

DB_HOST=your_postgres_host
DB_USER=your_postgres_user
DB_PASSWORD=your_postgres_password
DB_NAME=your_postgres_db

ORACLE_HOST=your_oracle_host
ORACLE_PORT=1521
ORACLE_SERVICE=your_service_name
ORACLE_USER=your_oracle_user
ORACLE_PASSWORD=your_oracle_password

LDAP_SERVER=ldap://your_ldap_host
LDAP_BASE_DN=dc=example,dc=com
LDAP_USER_DN=uid=admin,dc=example,dc=com
LDAP_PASSWORD=your_ldap_password

SUPERADMIN_USER=admin_root
SUPERADMIN_PASSWORD_HASH=scrypt:32768:8:1$...change_me
