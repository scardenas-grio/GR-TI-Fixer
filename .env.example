# Flask
SECRET_KEY=
# Poner en false solo si la app se sirve por HTTP en desarrollo
SESSION_COOKIE_SECURE=true
SESSION_LIFETIME_HOURS=8
# Origenes permitidos para Socket.IO, separados por coma (vacio = mismo origen)
CORS_ALLOWED_ORIGINS=

# PostgreSQL (aplicacion)
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Oracle
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_HOST=
ORACLE_PORT=1521
ORACLE_SERVICE=

# LDAP
LDAP_SERVER=
LDAP_BASE_DN=
LDAP_USER_DN=
LDAP_PASSWORD=

# Superadmin local (hash generado con werkzeug.security.generate_password_hash)
SUPERADMIN_USER=
SUPERADMIN_PASSWORD_HASH=

# MySQL (scripts legacy / migracion)
MYSQL_HOST=localhost
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=sistema_puntos_v5
